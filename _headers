# Cloudflare Pages headers

# HTML must always revalidate: it carries the inlined CSS and the reference to
# the content-hashed JS bundle, so a stale copy would pin an old build.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# JS is content-hashed by the build (site.<hash>.js), so a changed file always
# gets a new URL and can safely be cached hard.
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

# Images/video keep their filenames across deploys, so they revalidate rather
# than being pinned for a year.
/assets/*
  Cache-Control: public, max-age=300, must-revalidate

# The leads dashboard and its API must never be cached or indexed anywhere -
# not by the browser, not by Cloudflare's edge, not by a search crawler.
/admin
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/admin.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/api/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
